{
	"name": "fastify-boilerplate",
	"version": "1.0.0",
	"main": "index.js",
	"scripts": {
		"dev": "npx tsx watch src/server.ts",
		"build": "npx tsc",
		"format": "biome format ./src",
		"format-fix": "biome format --write ./src",
		"lint": "biome lint ./src",
		"lint-fix": "biome lint --write ./src",
		"model:create": "npx sequelize-cli model:generate --name",
		"seed:create": "npx sequelize-cli seed:create --name",
		"seed": "npx sequelize-cli db:seed:all",
		"seed:one": "npx sequelize-cli db:seed --seed",
		"migrate:create": "npx sequelize-cli migration:create --name",
		"migrate": "npx sequelize-cli db:migrate",
		"migrate:rollback": "npx sequelize-cli db:migrate:undo",
		"migrate:reset": "npx sequelize-cli db:migrate:undo:all",
		"migrate:refresh": "npm run migrate:reset && npm run migrate"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"description": "",
	"dependencies": {
		"@aws-sdk/client-s3": "^3.840.0",
		"@aws-sdk/s3-request-presigner": "^3.840.0",
		"@dotenvx/dotenvx": "^1.45.2",
		"@fastify/compress": "^8.1.0",
		"@fastify/cors": "^11.0.1",
		"@fastify/formbody": "^8.0.2",
		"@fastify/helmet": "^13.0.1",
		"@fastify/multipart": "^9.0.3",
		"@fastify/rate-limit": "^10.3.0",
		"axios": "^1.10.0",
		"bcrypt": "^6.0.0",
		"dayjs": "^1.11.13",
		"fastify": "^5.4.0",
		"fastify-multer": "^2.0.3",
		"multer-s3": "^3.0.1",
		"nodemailer": "^7.0.4",
		"pg": "^8.16.3",
		"pg-hstore": "^2.3.4",
		"reflect-metadata": "^0.2.2",
		"sequelize-typescript": "^2.1.6",
		"uuid": "^11.1.0",
		"winston": "^3.17.0",
		"yup": "^1.6.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.0.6",
		"@faker-js/faker": "^9.9.0",
		"@types/node": "^24.0.10",
		"@types/validator": "^13.15.2",
		"jest": "^30.0.3",
		"module-alias": "^2.2.3",
		"sequelize-cli": "^6.6.3",
		"ts-jest": "^29.4.0",
		"ts-node": "^10.9.2",
		"tsx": "^4.20.3",
		"typescript": "^5.8.3"
	}
}
